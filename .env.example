# Feature flags enabled at build time, comma-separated. Prefix a name with "-"
# to force it off. Unlisted flags fall back to their default in
# src/lib/flags.svelte.ts.
#
# On Vercel this is a project environment variable. The app is prerendered to
# static files, so a change needs a redeploy to take effect.
#
# Known flags: explore
PUBLIC_FLAGS=
