# Feature flags enabled at build time, comma-separated. Prefix a name with "-"
# to force it off. Unlisted flags fall back to their default in
# src/lib/flags.svelte.ts.
#
# On Vercel this is a project environment variable. The app is prerendered to
# static files, so a change needs a redeploy to take effect.
#
# Known flags: explore
PUBLIC_FLAGS=

# Anonymous usage analytics. Both must be set for anything to be sent; with
# either missing the tracker is a no-op, so local dev and CI are inert without
# any extra setup.
#
# On Vercel, set these in the Production environment only - that way preview
# deployments never pollute the numbers. The publishable key is meant to be
# public: row-level security makes the events table write-only. See
# supabase/schema.sql.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
