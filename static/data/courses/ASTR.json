{"ASTR 101":{"title":"Introduction to the Solar System","description":"General principles of the celestial sphere, laws of motion and light, optics, and telescopes; current knowledge of the Sun and Solar System.","hours":"3-2*-0","credits":{"min":3,"max":3},"prerequisite":{"kind":"oneOf","groupId":"g0","children":[{"kind":"highSchoolCourse","name":"PHYS 11","raw":"PHYS 11"},{"kind":"highSchoolCourse","name":"PHYS 12","raw":"PHYS 12"},{"kind":"course","code":"PHYS 100","raw":"PHYS_V 100"},{"kind":"course","code":"PHYS_O 112","raw":"PHYS_O 112"},{"kind":"highSchoolCourse","name":"Principles of Mathematics 12","raw":"Principles of Mathematics 12"}]},"corequisite":null,"prerequisiteText":"One of PHYS 11, PHYS 12, PHYS_V 100, PHYS_O 112 and Principles of Mathematics 12","corequisiteText":null,"notes":[],"equivalentTo":[],"creditExcludedWith":[],"url":"https://vancouver.calendar.ubc.ca/course-descriptions/courses/astrv-101-introduction-solar-system"},"ASTR 102":{"title":"Introduction to Stars and Galaxies","description":"Modern stellar and extragalactic astronomy. Stars and stellar evolution from protostars to black holes; galaxies and quasars; cosmology. ASTR_V 200/205 rather than ASTR_V 102 are recommended for students who intend to pursue studies in Astronomy.","hours":"3-2*-0","credits":{"min":3,"max":3},"prerequisite":{"kind":"oneOf","groupId":"g0","children":[{"kind":"highSchoolCourse","name":"PHYS 11","raw":"PHYS 11"},{"kind":"highSchoolCourse","name":"PHYS 12","raw":"PHYS 12"},{"kind":"course","code":"PHYS 100","raw":"PHYS_V 100"},{"kind":"course","code":"PHYS_O 112","raw":"PHYS_O 112"},{"kind":"highSchoolCourse","name":"Principles of Mathematics 12","raw":"Principles of Mathematics 12"}]},"corequisite":null,"prerequisiteText":"One of PHYS 11, PHYS 12, PHYS_V 100, PHYS_O 112 and Principles of Mathematics 12","corequisiteText":null,"notes":[],"equivalentTo":[],"creditExcludedWith":[],"url":"https://vancouver.calendar.ubc.ca/course-descriptions/courses/astrv-102-int